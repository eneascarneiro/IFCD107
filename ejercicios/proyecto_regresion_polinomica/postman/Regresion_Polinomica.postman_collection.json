  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/health"
      }
    },
    {
      "name": "Consultar listas de parámetros",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/regresion/parametros",
        "description": "Devuelve cada parámetro con sus opciones en la propiedad items. Para activar una búsqueda en los endpoints de entrenamiento, enviar search=true, n_iter y search_cv."
      }
    },
    {
      "name": "Obtener token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Credenciales aceptadas\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) { pm.collectionVariables.set(\"token\", pm.response.json().access_token); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/auth/token"
      }
    },
    {
      "name": "Ajustar desde JSON",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reference\": \"{{reference}}\",\n  \"degree\": 2,\n  \"data\": [\n    {\"x\": -3, \"y\": 10.1},\n    {\"x\": -2, \"y\": 5.9},\n    {\"x\": -1, \"y\": 2.2},\n    {\"x\": 0, \"y\": 1.0},\n    {\"x\": 1, \"y\": 1.8},\n    {\"x\": 2, \"y\": 6.2},\n    {\"x\": 3, \"y\": 10.0},\n    {\"x\": 4, \"y\": 17.1}\n  ]\n}"
        },
        "url": "{{baseUrl}}/api/v1/regresion/polinomica"
      }
    },
    {
      "name": "Ajustar desde CSV",
      "request": {
        "method": "POST",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "reference",
              "value": "{{reference}}",
              "type": "text"
