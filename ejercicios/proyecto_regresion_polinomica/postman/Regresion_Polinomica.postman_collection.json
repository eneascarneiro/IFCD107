      "key": "reference",
      "value": "terrazas_madrid_demo"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "last_eda_preprocessed_csv",
