# Copia este archivo a .env y sustituye los valores de ejemplo.
API_ADMIN_PASSWORD=replace-with-a-long-random-password
API_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-bytes
API_TOKEN_TTL_SECONDS=3600

# Perfiles de Dify necesarios cuando se usa su Compose mediante include.
COMPOSE_PROFILES=weaviate,postgresql,collaboration

# Modelos locales Ollama (descarga inicial de varios GB).
OLLAMA_MODEL_LLAMA3=llama3:8b
OLLAMA_MODEL_MISTRAL=mistral:7b
OLLAMA_MODEL=llama3:8b
OLLAMA_PORT=11434

# Interfaces locales
N8N_PORT=5678
FLOWISE_PORT=3001
FLOWISE_IMAGE=flowiseai/flowise:3.1.3
GENERIC_TIMEZONE=Europe/Paris
